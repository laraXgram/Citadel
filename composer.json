{
    "name": "laraxgram/citadel",
    "description": "API authentication for LaraGram: personal access tokens, SPA sessions and a full OAuth2 server with Telegram sign-in.",
    "keywords": [
        "laragram",
        "auth",
        "oauth",
        "tokens",
        "telegram",
        "citadel"
    ],
    "homepage": "https://github.com/laraxgram/citadel",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laraxgram/citadel/issues",
        "source": "https://github.com/laraxgram/citadel"
    },
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "laraxgram/core": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "LaraGram\\Citadel\\": "src/",
            "LaraGram\\Citadel\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        },
        "laragram": {
            "providers": [
                "LaraGram\\Citadel\\CitadelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
